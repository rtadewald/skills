      card pad=42
        image pad=20
          row h=40
            space
            pill w=80 h=40 solid
          space
          row h=46 gap=8
            space
            dot size=46
            dot size=46
      pill h=44 knob=both
    col gap=14 f=3
      card
        lines n=2 bold
        space
        pill w=80 h=46 solid
